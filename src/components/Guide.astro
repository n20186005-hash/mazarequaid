---
import BaseLayout from '../layouts/BaseLayout.astro';
import {SITE} from '../data/site';
import {GUIDE} from '../data/guide';
const {locale = 'ur'} = Astro.props as {locale:'ur'|'en'};
const t=GUIDE[locale];
const canonical = `https://mazarequaid.com/${locale==='en'?'en/':''}`;
const schema={'@context':'https://schema.org','@type':'TouristAttraction',name:SITE.name,url:canonical,address:{'@type':'PostalAddress',...SITE.address},geo:{'@type':'GeoCoordinates',...SITE.geo},hasMap:SITE.mapsUrl};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout locale={locale} title={t.title} description={t.description} canonical={canonical}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
<section class="bg-[#17473e] py-12 text-white"><div class="container-shell grid items-start gap-10 lg:grid-cols-2"><div class="min-w-0"><p class="text-sm text-[#e9c77a]">{t.sub}</p><h1 class="guide-title display mt-5 text-5xl font-bold lg:text-6xl">{t.name}</h1><p class="mt-6 text-lg leading-9">{t.intro}</p><p class="mt-6 rounded-xl border border-white/30 p-4"><span class="block">{t.rating}</span><bdi dir="ltr" class="block text-xl font-bold">4.6 / 5 · 15,031</bdi><span class="mt-2 block text-sm">{t.ratingDate}</span><a href={SITE.mapsUrl} class="underline">Google Maps ↗</a></p><a href="#visit" class="mt-6 inline-block rounded-full bg-[#e9c77a] px-5 py-3 font-bold text-[#162b27]">{locale==='en'?'Check access before you go':'جانے سے پہلے داخلے کی تصدیق'}</a></div><figure class="min-w-0"><img src="/images/mazar-upper.webp" width="1600" height="940" alt={t.photoAlt} class="h-auto w-full rounded-xl" fetchpriority="high"/><figcaption class="mt-4 text-sm leading-8"><span dir="ltr" class="inline-block"><a href="https://commons.wikimedia.org/wiki/File:Jinnah_Mausoleum.JPG" class="underline">Jinnah Mausoleum.JPG</a> · <a href="https://commons.wikimedia.org/wiki/User:M.irfan44" class="underline">M.irfan44</a> / <a href="https://commons.wikimedia.org/wiki/User:Willard84" class="underline">Willard84</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline">CC BY-SA 4.0</a></span><span class="mt-2 block">{t.photoDate}</span></figcaption></figure></div></section>
<section id="visit" class="bg-[#e9dfc9] py-14"><div class="container-shell"><h2 class="text-3xl font-bold">{t.noticeTitle}</h2><p class="mt-5 max-w-4xl leading-9">{t.notice}</p><p class="mt-4 text-sm leading-8">{t.checked}</p><a href={SITE.authority} class="mt-5 inline-block rounded-full bg-[#17473e] px-5 py-3 font-bold text-white">{t.authority} ↗</a><h2 class="mt-12 text-3xl font-bold">{t.visitTitle}</h2><div class="mt-7 grid gap-6 md:grid-cols-2">{t.planning.map(([title,text])=><article class="rounded-2xl border border-[#162b27]/15 bg-white p-6"><h3 class="text-xl font-bold">{title}</h3><p class="mt-4 leading-9">{text}</p></article>)}</div><p class="mt-6"><a class="underline" href="https://qmmb.gov.pk/terms-cond.html">{locale==='en'?'QMMB rules and photography licence':'QMMB کے قواعد اور فوٹوگرافی لائسنس'} ↗</a></p></div></section>
<section id="intro" class="py-16"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-bold">{t.aboutTitle}</h2><p class="mt-5 leading-9">{t.about}</p><p class="mt-5 leading-9">{t.historyNote}</p><a href="https://doam.gov.pk/public/sites/6039" class="mt-5 inline-block underline">{locale==='en'?'Federal archaeology inventory':'وفاقی محکمۂ آثارِ قدیمہ کا اندراج'} ↗</a></div></section>
<section id="around" class="bg-[#e7f0ea] py-14"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-bold">{t.aroundTitle}</h2><p class="mt-5 leading-9">{t.around}</p></div></section>
<section id="map" class="py-16"><div class="container-shell grid min-w-0 gap-8 lg:grid-cols-2"><div class="min-w-0"><h2 class="text-3xl font-bold">{t.mapTitle}</h2><p class="mt-5 leading-9">{t.map}</p><p class="mt-4"><bdi dir="ltr">24.8753868, 67.0409721</bdi></p><p class="mt-5 leading-9">{t.mapNote}</p><a href={SITE.mapsUrl} class="mt-6 inline-block rounded-full bg-[#17473e] px-5 py-3 font-bold text-white">{t.mapButton} ↗</a></div><iframe title={t.mapTitleIframe} src="https://www.google.com/maps?q=24.8753868,67.0409721&z=16&output=embed" width="100%" height="420" class="w-full rounded-2xl border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section id="faq" class="bg-[#e7f0ea] py-14"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-bold">{t.faqTitle}</h2><div class="mt-7 divide-y divide-[#162b27]/20">{t.faq.map(([q,a])=><details class="py-5"><summary class="cursor-pointer text-xl font-bold">{q}</summary><p class="mt-4 leading-9">{a}</p></details>)}</div></div></section>
<section id="sources" class="py-16"><div class="container-shell max-w-4xl"><h2 class="text-3xl font-bold">{t.sourcesTitle}</h2><p class="mt-5 leading-9">{t.sourcesNote}</p><ul class="mt-5 list-disc space-y-4 ps-6"><li><a href="https://qmmb.gov.pk/" class="underline">Quaid-i-Azam Mazar Management Board</a> · <a href={SITE.authority} class="underline">{locale==='en'?'Official contact':'سرکاری رابطہ'}</a></li><li><a href="https://doam.gov.pk/public/sites/6039" class="underline">{locale==='en'?'Department of Archaeology and Museums inventory':'محکمۂ آثارِ قدیمہ و عجائب گھر کا اندراج'}</a></li><li><a href="https://www.senate.gov.pk/com/pressreleasedetail.php?id=MzI2&amp;pressid=NzYyNQ%3D%3D" class="underline">{locale==='en'?'Senate: 8 July 2026':'سینیٹ: ۸ جولائی ۲۰۲۶'}</a> · <a href="https://senate.gov.pk/com/pressreleasedetail.php?id=MzI2&amp;pressid=Nzc1Ng%3D%3D" class="underline">{locale==='en'?'7 August 2026':'۷ اگست ۲۰۲۶'}</a></li><li><a href={SITE.mapsUrl} class="underline">Google Maps</a> · {locale==='en'?'third-party location and dated review snapshot':'تیسرے فریق کا مقام اور تاریخ کے ساتھ آرا کی تعداد'}</li></ul><h3 class="mt-10 text-2xl font-bold">{t.privacyTitle}</h3><p class="mt-5 leading-9">{t.privacy}</p><p class="mt-5 flex flex-wrap gap-5"><a href="https://policies.google.com/privacy" class="underline">{locale==='en'?'Google privacy':'Google کی رازداری'}</a><a href="https://www.cloudflare.com/privacypolicy/" class="underline">{locale==='en'?'Cloudflare privacy':'Cloudflare کی رازداری'}</a><a href="https://developers.cloudflare.com/web-analytics/data-metrics/" class="underline">Cloudflare Web Analytics</a></p></div></section>
</BaseLayout>
