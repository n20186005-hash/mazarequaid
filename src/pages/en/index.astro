---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, hoursEn } from '../../data/site';

const site = Astro.site;
const canonicalUrl = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const heroImageUrl = site ? new URL('/images/mazar-exterior.jpg', site).toString() : '/images/mazar-exterior.jpg';
const cityImageUrl = site ? new URL('/images/mazar-city.jpg', site).toString() : '/images/mazar-city.jpg';
const detailImageUrl = site ? new URL('/images/mazar-detail.jpg', site).toString() : '/images/mazar-detail.jpg';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${canonicalUrl}#attraction`,
  name: 'Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid)',
  alternateName: [
    'Mazar-e-Quaid',
    'Jinnah Mausoleum',
    'National Mausoleum of Pakistan',
    'Quaid-e-Azam Mausoleum',
    'Quaid-e-Azam Muhammad Ali Jinnah Mausoleum',
    'مزارِ قائد اعظم محمد علی جناح',
  ],
  description: 'Visitor guide to Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) in Karachi, Pakistan — opening hours, ticket price, location map, how to get there, and the history of the national mausoleum.',
  url: canonicalUrl,
  image: [heroImageUrl, cityImageUrl, detailImageUrl],
  isAccessibleForFree: SITE.isAccessibleForFree,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.streetAddress,
    addressLocality: SITE.address.addressLocality,
    addressRegion: SITE.address.addressRegion,
    addressCountry: SITE.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.latitude,
    longitude: SITE.geo.longitude,
  },
  hasMap: SITE.mapsUrl,
  telephone: SITE.phone,
  openingHoursSpecification: SITE.openingHoursSpecification,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE.ratingValue,
    reviewCount: SITE.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: SITE.sameAs,
  containedInPlace: {
    '@type': 'Park',
    name: 'Jinnah Park (Mazar-e-Quaid Complex)',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Karachi',
      addressRegion: 'Sindh',
      addressCountry: 'PK',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pakistan', item: canonicalUrl },
    { '@type': 'ListItem', position: 2, name: 'Sindh', item: canonicalUrl },
    { '@type': 'ListItem', position: 3, name: 'Karachi', item: canonicalUrl },
    { '@type': 'ListItem', position: 4, name: 'Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid)', item: `${canonicalUrl}#attraction` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is Mazar-e-Quaid located?',
      acceptedAnswer: { '@type': 'Answer', text: 'Mazar-e-Quaid (Muhammad Ali Jinnah Mausoleum) is located in Karachi, Sindh, Pakistan, on Muhammad Ali Jinnah Road within Jinnah Park (Central Jacob Lines). The Plus Code is V2GR+59 Central Jacob Lines, Karachi.' },
    },
    {
      '@type': 'Question',
      name: 'What are the visiting hours of Mazar-e-Quaid?',
      acceptedAnswer: { '@type': 'Answer', text: 'General visiting hours are 2:00 PM – 5:30 PM on Monday, Tuesday, Friday, Saturday and Sunday, and 10:00 AM – 5:30 PM on Wednesday and Thursday. Hours may change during official ceremonies, Friday prayers, or for security reasons — confirm on-site before you travel.' },
    },
    {
      '@type': 'Question',
      name: 'Is there a ticket price for Mazar-e-Quaid?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. Mazar-e-Quaid is a public national monument and entry is free during official opening hours. There is no standard paid ticket; for any special museum or programmed event, check on-site.' },
    },
    {
      '@type': 'Question',
      name: 'How to reach Mazar-e-Quaid in Karachi?',
      acceptedAnswer: { '@type': 'Answer', text: 'The mausoleum is centrally located in Karachi on Muhammad Ali Jinnah Road and is easily reachable by car, ride-hailing apps (Careem / Uber / local cab), and public transport. The Plus Code is V2GR+59 Central Jacob Lines, Karachi.' },
    },
    {
      '@type': 'Question',
      name: 'Who is buried at Mazar-e-Quaid?',
      acceptedAnswer: { '@type': 'Answer', text: 'Mazar-e-Quaid is the final resting place of Quaid-e-Azam Muhammad Ali Jinnah, the founder of Pakistan. The complex also honours other members of the Jinnah family.' },
    },
    {
      '@type': 'Question',
      name: 'What is the best time to visit Mazar-e-Quaid?',
      acceptedAnswer: { '@type': 'Answer', text: 'Because of Karachi’s heat, early morning or just before sunset is the most comfortable time. Evenings can be pleasant in the cooler months. Allow about 90–120 minutes to see the gardens, fountains, mausoleum and museum calmly.' },
    },
    {
      '@type': 'Question',
      name: 'Is Mazar-e-Quaid free to visit?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. The mausoleum and surrounding gardens are free to enter during official hours. It is a national monument and a place of remembrance, so modest dress and quiet behaviour are appreciated.' },
    },
    {
      '@type': 'Question',
      name: 'What is near Mazar-e-Quaid?',
      acceptedAnswer: { '@type': 'Answer', text: 'Nearby landmarks include Frere Hall (colonial heritage), the National Museum of Pakistan, and Quaid-e-Azam House Museum. Karachi’s food streets — Burns Road, Saddar bazaar and Sindhi cuisine restaurants — are a short ride away.' },
    },
  ],
};

const hours = hoursEn;

const attractions = [
  { title: 'Frere Hall', meta: 'Colonial heritage · Gardens', text: 'A historic building rich with symmetrical lines and arched detail — a different mood of the city, worth pairing with your mausoleum visit.' },
  { title: 'National Museum of Pakistan', meta: 'History · Culture', text: 'A meaningful next stop to read the civilisational story of Sindh and Pakistan through its collections.' },
  { title: 'Quaid-e-Azam House', meta: 'Historic house · Museum', text: 'A close look at the founder’s private life, work and connection with Karachi.' },
];

const foods = [
  { name: 'Burns Road', tag: 'Traditional Karachi flavours', text: 'The city’s famous food street for sajji, nihari, haleem, kebabs and sweets — liveliest in the evening.' },
  { name: 'Saddar Bazaar', tag: 'Tea · Light bites', text: 'Tea and simple local meals as you move from the mausoleum toward the old commercial heart of the city.' },
  { name: 'Sindhi flavours', tag: 'Local experience', text: 'Biryani, karahi and Sindhi-style dishes at local restaurants can become part of your Karachi trip.' },
];

const sourceItems = [
  {
    title: 'Official place data — Google Maps',
    desc: 'Reference for rating, price indicator, hours, verified photos and user reviews. We cite the official Google Maps listing for this monument in Sindh.',
    href: 'https://maps.app.goo.gl/hnCrj26Z2LjHTYx28',
  },
  {
    title: 'Pakistan Tourism Development Corporation',
    desc: 'Federal tourism data, travel guidance and official information portal.',
    href: 'https://www.tourism.gov.pk/',
  },
  {
    title: 'Government of Sindh — Tourism & Culture',
    desc: 'Official reference for Sindh’s cultural heritage, festivals and provincial tourism initiatives.',
    href: 'https://sindh.gov.pk/',
  },
  {
    title: 'Directorate of Archaeology, Sindh',
    desc: 'Official information on national monuments, archaeology and preservation in Karachi and Sindh.',
    href: 'http://www.archaeologysindh.gov.pk/',
  },
];
---

<BaseLayout locale="en">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <section class="grain relative isolate min-h-[720px] overflow-hidden bg-[#0d201d] text-white" aria-labelledby="hero-title">
    <img src="/images/mazar-exterior.jpg" alt="Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — main view in Karachi, Pakistan" class="hero-image absolute inset-0 h-full w-full object-cover object-center opacity-65" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(13,32,29,.93)_0%,rgba(13,32,29,.68)_40%,rgba(13,32,29,.18)_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(13,32,29,.92)_0%,transparent_42%,rgba(13,32,29,.35)_100%)]"></div>
    <div class="container-shell relative flex min-h-[720px] items-end pb-20 pt-32 sm:pb-28">
      <div class="max-w-2xl reveal">
        <div class="mb-6 flex items-center gap-3 text-xs font-bold tracking-[.18em] text-[#e9c77a]"><span class="h-px w-12 bg-[#e9c77a]"></span>Karachi · Sindh · Pakistan</div>
        <p class="mb-4 text-2xl font-medium text-[#d9e6df] sm:text-3xl">Muhammad Ali Jinnah Mausoleum — Mazar-e-Quaid</p>
        <h1 id="hero-title" class="display max-w-xl text-5xl font-extrabold leading-[1.16] text-[#fbfaf7] sm:text-7xl">The nation's memory,<br /><span class="text-[#e9c77a]">kept in silence</span></h1>
        <p class="mt-7 max-w-xl text-base leading-9 text-[#dbe7e1] sm:text-lg">Welcome to <strong class="font-bold text-[#e9c77a]">Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid)</strong>, the white-marble national mausoleum and final resting place of the founder of Pakistan. In the heart of Karachi, Sindh, it is a primary stop for travellers exploring the city.</p>
        <p class="mt-3 max-w-xl text-xs leading-6 text-[#9fbab0]">Muhammad Ali Jinnah Mausoleum (Karachi) → Karachi → Sindh → Pakistan</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#intro" class="rounded-full bg-[#e9c77a] px-6 py-3 text-sm font-extrabold text-[#162b27] shadow-lg shadow-black/20 transition hover:-translate-y-1 hover:bg-[#f1d58f]">About the mausoleum</a>
          <a href="#visit" class="rounded-full border border-white/35 bg-white/5 px-6 py-3 text-sm font-extrabold text-white backdrop-blur-sm transition hover:-translate-y-1 hover:border-white hover:bg-white/15">Plan your visit</a>
          <a href="https://maps.app.goo.gl/hnCrj26Z2LjHTYx28" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#e9c77a]/60 px-6 py-3 text-sm font-extrabold text-[#e9c77a] transition hover:-translate-y-1 hover:bg-[#e9c77a] hover:text-[#162b27]">Google Maps ↗</a>
        </div>
      </div>
      <div class="absolute bottom-8 left-0 right-0 hidden items-center justify-between text-[11px] text-white/60 sm:flex"><span>01 / 07 · National monument</span><span>Scroll down ↓</span></div>
    </div>
  </section>

  <section id="intro" class="bg-[#fbfaf7] py-20 sm:py-28">
    <div class="container-shell grid gap-14 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow mb-4">One place, many layers</p>
        <h2 class="display max-w-lg text-4xl font-extrabold leading-tight text-[#17473e] sm:text-5xl">Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — Karachi</h2>
        <p class="mt-3 text-sm font-bold text-[#b68a4a]">About Mazar-e-Quaid</p>
        <div class="mt-7 section-rule max-w-sm"></div>
        <p class="mt-7 max-w-xl text-base leading-9 text-[#526963]">Mazar-e-Quaid is the final resting place of Muhammad Ali Jinnah, founder of Pakistan, and one of Karachi’s most recognisable landmarks. Set on a raised platform at the end of Muhammad Ali Jinnah Road within the green expanse of Jinnah Park, it is both a monument and a place of quiet remembrance.</p>
        <p class="mt-4 max-w-xl text-base leading-9 text-[#526963]">White marble, clean geometric forms, copper screens and a restrained dome bring calm from afar; up close, the arches, light and material detail reveal themselves. It is a central point from which to explore the surrounding historical landmarks of Karachi.</p>
        <p class="mt-4 max-w-xl text-sm leading-7 text-[#526963]">When visiting <strong class="font-bold text-[#17473e]">Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid)</strong>, travellers can easily combine nearby sites such as <strong class="font-bold text-[#17473e]">Frere Hall</strong>, the <strong class="font-bold text-[#17473e]">National Museum of Pakistan</strong>, and <strong class="font-bold text-[#17473e]">Quaid-e-Azam House</strong>.</p>
        <div class="mt-8 flex items-center gap-4 text-sm font-bold text-[#17473e]"><span class="grid h-11 w-11 place-items-center rounded-full bg-[#e7f0ea] text-xl text-[#b68a4a]">✦</span> A balanced meeting of tradition and modernity</div>
      </div>
      <figure class="relative">
        <div class="absolute -inset-4 rounded-[2.5rem] border border-[#b68a4a]/30"></div>
        <img src="/images/mazar-city.jpg" alt="Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) seen against the green cityscape of Karachi, Pakistan" class="relative aspect-[4/3] w-full rounded-[2rem] object-cover shadow-[0_30px_80px_rgba(22,43,39,.18)]" loading="lazy" />
        <figcaption class="relative -mt-5 mr-6 ml-6 rounded-xl bg-[#17473e] px-5 py-3 text-xs leading-6 text-[#e7f0ea] shadow-lg">White dome, green gardens and the Karachi skyline — three defining layers of the mausoleum.</figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-[#e7f0ea] py-20 sm:py-24" aria-labelledby="architecture-title">
    <div class="container-shell">
      <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow mb-3">Architecture</p><h2 id="architecture-title" class="display text-4xl font-extrabold text-[#17473e] sm:text-5xl">History &amp; Significance of Mazar-e-Quaid</h2><p class="mt-3 text-xs font-bold uppercase tracking-[.18em] text-[#b68a4a]">Architecture &amp; Symbolism</p></div><p class="max-w-md text-sm leading-8 text-[#526963]">A blend of traditional Islamic and modern geometric language, transformed by both daylight and evening illumination.</p></div>
      <div class="grid gap-5 md:grid-cols-[1.3fr_.7fr]">
        <div class="group relative min-h-[450px] overflow-hidden rounded-[2rem] bg-[#17473e]"><img src="/images/mazar-detail.jpg" alt="Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — white-marble arches and architectural detail in Karachi" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-[#0d201d]/90 via-[#0d201d]/15 to-transparent"></div><div class="absolute bottom-7 right-7 left-7 text-white"><p class="text-xs font-bold tracking-[.18em] text-[#e9c77a]">01 · Material language</p><h3 class="display mt-2 text-3xl font-bold">White marble</h3><p class="mt-2 max-w-md text-sm leading-7 text-white/75">A symbol of purity and dignity — quiet from a distance, richly detailed up close.</p></div></div>
        <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-1">
          <article class="rounded-[2rem] bg-[#17473e] p-7 text-[#e7f0ea] shadow-sm"><span class="text-2xl text-[#e9c77a]">⌁</span><p class="mt-5 text-xs font-bold tracking-[.18em] text-[#e9c77a]">02 · Layout</p><h3 class="display mt-2 text-2xl font-bold">Axis of fifteen fountains</h3><p class="mt-3 text-sm leading-7 text-[#b7ccc1]">The central approach leads the visitor across a still pool of water to the raised platform of the monument.</p></article>
          <article class="rounded-[2rem] bg-[#f5f3ec] p-7 text-[#17473e] shadow-sm"><span class="text-2xl text-[#b68a4a]">◌</span><p class="mt-5 text-xs font-bold tracking-[.18em] text-[#b68a4a]">03 · Inner calm</p><h3 class="display mt-2 text-2xl font-bold">A touch of green light</h3><p class="mt-3 text-sm leading-7 text-[#526963]">The cool interior and green crystal chandelier give the monument a different feeling from the sun outside.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section id="visit" class="bg-[#f5f3ec] py-20 sm:py-28" aria-labelledby="visit-title">
    <div class="container-shell">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div><p class="eyebrow mb-4">Before you arrive</p><h2 id="visit-title" class="display text-4xl font-extrabold leading-tight text-[#17473e] sm:text-5xl">Location &amp; How to Visit Mazar-e-Quaid in Karachi</h2><p class="mt-6 max-w-md text-base leading-9 text-[#526963]">The real pleasure here is not in a rush, but in a few quiet moments. Allow time, keeping the season, security and the latest on-site guidance in mind.</p><div class="mt-8 rounded-2xl border border-[#b68a4a]/40 bg-[#fbfaf7] p-5"><p class="text-xs font-extrabold text-[#b68a4a]">Important note</p><p class="mt-2 text-sm leading-7 text-[#526963]">Hours and access may change for official events, prayers or security reasons. Please re-confirm via Google Maps or the mausoleum administration before you set out.</p></div></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article class="rounded-2xl bg-[#17473e] p-6 text-[#e7f0ea]">
            <p class="text-xs font-bold tracking-[.15em] text-[#e9c77a]">Rating</p>
            <p class="mt-3 text-4xl font-extrabold">4.6 <span class="text-lg text-[#e9c77a]">★</span> <span class="text-base font-bold text-[#e7f0ea]/85">(15,009)</span></p>
            <p class="mt-2 text-xs text-[#b7ccc1]">Public rating on Google Maps</p>
            <p class="mt-3 text-[10px] leading-5 text-[#9fbab0]">Rating and review count from Google Maps user reviews · Sept 2026 · <a href="https://maps.app.goo.gl/hnCrj26Z2LjHTYx28" target="_blank" rel="noopener noreferrer" class="underline decoration-[#e9c77a]/60 underline-offset-2 hover:text-[#e9c77a]">See all reviews on Google Maps ↗</a></p>
          </article>
          <article class="rounded-2xl bg-[#e7f0ea] p-6 text-[#17473e]"><p class="text-xs font-bold tracking-[.15em] text-[#b68a4a]">Suggested duration</p><p class="mt-3 text-4xl font-extrabold">90–120 <span class="text-lg">min</span></p><p class="mt-2 text-xs text-[#526963]">Gardens, mausoleum &amp; museum</p></article>
          <article class="rounded-2xl border border-[#17473e]/15 bg-[#fbfaf7] p-6 text-[#17473e]"><p class="text-xs font-bold tracking-[.15em] text-[#b68a4a]">Best time</p><p class="mt-3 text-2xl font-extrabold">Morning or evening</p><p class="mt-2 text-xs leading-6 text-[#526963]">Avoid the midday sun in summer; evening light softens the building.</p></article>
          <article class="rounded-2xl border border-[#17473e]/15 bg-[#fbfaf7] p-6 text-[#17473e]"><p class="text-xs font-bold tracking-[.15em] text-[#b68a4a]">Entry / Ticket</p><p class="mt-3 text-2xl font-extrabold">Free entry</p><p class="mt-2 text-xs leading-6 text-[#526963]">No standard paid ticket; ask on-site for any special museum or event.</p></article>
        </div>
      </div>
      <div class="mt-16 grid gap-10 border-t border-[#17473e]/15 pt-12 lg:grid-cols-2">
        <div><div class="mb-6 flex items-end justify-between"><h3 class="display text-2xl font-extrabold text-[#17473e]">General visiting hours</h3><span class="text-xs text-[#526963]">Local time</span></div><div class="overflow-hidden rounded-2xl border border-[#17473e]/10 bg-[#fbfaf7]"><div class="grid grid-cols-[.7fr_1fr] border-b border-[#17473e]/10 bg-[#e7f0ea] px-5 py-3 text-xs font-extrabold text-[#17473e]"><span>Day</span><span>Hours</span></div>{hours.map(([day, time], i) => <div class:list={["grid grid-cols-[.7fr_1fr] px-5 py-2.5 text-sm", i % 2 === 1 && 'bg-[#f5f3ec]']}><span class="font-bold text-[#17473e]">{day}</span><span class="text-[#526963]">{time}</span></div>)}</div></div>
        <div><h3 class="display mb-6 text-2xl font-extrabold text-[#17473e]">Parking &amp; access</h3><div class="space-y-4 text-sm leading-8 text-[#526963]"><p><strong class="text-[#17473e]">By car:</strong> The mausoleum is reachable from the main roads around Jinnah Park. During busy periods, follow the directions of on-site security staff for entry routes and parking.</p><p><strong class="text-[#17473e]">Parking:</strong> Availability of designated parking varies by day and security arrangements; arriving early is best, and avoid unauthorised roadside parking.</p><p><strong class="text-[#17473e]">Dress &amp; conduct:</strong> This is a national monument and a place of burial, so wear modest clothing and keep a quiet, respectful manner.</p></div></div>
      </div>
    </div>
  </section>

  <section id="reviews" class="bg-[#fbfaf7] py-20 sm:py-24" aria-labelledby="reviews-title">
    <div class="container-shell">
      <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="eyebrow mb-3">Summary of visitor reviews</p>
          <h2 id="reviews-title" class="display text-3xl font-extrabold text-[#17473e] sm:text-4xl">What visitors say</h2>
        </div>
        <a href="https://maps.app.goo.gl/hnCrj26Z2LjHTYx28" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 self-start rounded-full bg-[#17473e] px-5 py-2.5 text-xs font-extrabold text-[#e7f0ea] transition hover:bg-[#0d201d]">See all reviews on Google Maps ↗</a>
      </div>
      <div class="mb-8 rounded-2xl border border-[#b68a4a]/35 bg-[#f5f3ec] p-5 text-xs leading-6 text-[#526963]">
        <p class="font-extrabold text-[#17473e]">Ratings and reviews are taken from Google Maps user reviews, accurate as of September 2026; all rights of publishers and Google Maps are reserved.</p>
        <p class="mt-1">Reviews are presented only on this page and are not altered; for the full 15,009 user reviews and latest information, use the button above or view <a href="https://maps.app.goo.gl/hnCrj26Z2LjHTYx28" target="_blank" rel="noopener noreferrer" class="font-bold text-[#17473e] underline decoration-[#b68a4a] underline-offset-2">Google Maps ↗</a>.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-[#17473e]/12 bg-[#f5f3ec] p-6"><div class="flex items-center gap-2 text-[#b68a4a] text-sm font-extrabold">★★★★★</div><p class="mt-4 text-sm leading-7 text-[#526963]">“A beautiful and peaceful place. A fine refuge in busy Karachi — the fountains and dome are worth seeing.”</p><p class="mt-4 text-xs text-[#7d8f86]">— Google Maps user</p></article>
        <article class="rounded-2xl border border-[#17473e]/12 bg-[#f5f3ec] p-6"><div class="flex items-center gap-2 text-[#b68a4a] text-sm font-extrabold">★★★★★</div><p class="mt-4 text-sm leading-7 text-[#526963]">“A living piece of history. The shine of the marble, the cleanliness and the order are calming.”</p><p class="mt-4 text-xs text-[#7d8f86]">— Google Maps user</p></article>
        <article class="rounded-2xl border border-[#17473e]/12 bg-[#f5f3ec] p-6"><div class="flex items-center gap-2 text-[#b68a4a] text-sm font-extrabold">★★★★</div><p class="mt-4 text-sm leading-7 text-[#526963]">“A place that connects the new generation with its founder. It can get a little crowded at peak times, so mornings are better.”</p><p class="mt-4 text-xs text-[#7d8f86]">— Google Maps user</p></article>
      </div>
    </div>
  </section>

  <section id="around" class="bg-[#fbfaf7] py-20 sm:py-28" aria-labelledby="around-title">
