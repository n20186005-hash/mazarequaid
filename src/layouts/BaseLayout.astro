---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const {
  title = 'Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — Karachi Visitor Guide | مزارِ قائد',
  description = 'Discover Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid), the iconic white-marble national mausoleum in Karachi, Sindh, Pakistan. View location map, opening hours, nearby landmarks, and travel tips.',
  image = '/images/mazar-exterior.jpg',
  noindex = false,
  canonical,
} = Astro.props;

const site = Astro.site;
const canonicalUrl = canonical
  ?? (site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname);
const imageUrl = site ? new URL(image, site).toString() : image;
const ogTitle = 'Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — Karachi Travel Guide';

const navItems = [
  ['تعارف', '#intro'],
  ['دیکھنے کا وقت', '#visit'],
  ['اردگرد', '#around'],
  ['نقشہ', '#map'],
  ['سوالات', '#faq'],
  ['ماخذ', '#sources'],
];
---
<!doctype html>
<html lang="ur" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#17473e" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Muhammad Ali Jinnah Mausoleum, Mazar-e-Quaid, Jinnah Mausoleum Karachi, مزارِ قائد, National Mausoleum Pakistan, Karachi landmarks, Sindh tourism, Jinnah Park, 领袖陵, 卡拉奇景点" />
    <meta name="author" content="Mazar-e-Quaid Visitor Guide" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="rating" content="general" />
    <meta name="geo.region" content="PK-SD" />
    <meta name="geo.placename" content="Karachi, Sindh, Pakistan" />
    <meta name="geo.position" content="24.875354;67.040835" />
    <meta name="ICBM" content="24.875354, 67.040835" />
    <meta name="language" content="Urdu, English, Chinese" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link rel="mask-icon" href="/favicon.svg" color="#17473e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ur" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Mazar-e-Quaid Guide" />
    <meta name="apple-mobile-web-app-title" content="Mazar-e-Quaid" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:locale" content="ur_PK" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="مزارِ قائد — Mazar-e-Quaid Guide" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) — main view in Karachi, Pakistan" />
    <meta property="og:updated_time" content="2026-09-15T00:00:00Z" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Muhammad Ali Jinnah Mausoleum (Mazar-e-Quaid) in Karachi" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline define:vars={{ canonicalUrl }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP', { page_location: canonicalUrl });
    </script>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-20 text-white">
      <div class="container-shell flex items-center justify-between gap-6 py-5">
        <a href="#top" class="group flex items-center gap-3" aria-label="مزارِ قائد، آغاز صفحہ">
          <img src="/logo.svg" width="180" height="46" alt="مزارِ قائد" class="h-auto w-[150px] transition duration-300 group-hover:opacity-80 sm:w-[180px]" />
        </a>
        <nav aria-label="مرکزی نیویگیشن" class="hidden items-center gap-6 text-[13px] font-bold lg:flex">
          {navItems.map(([label, href]) => <a class="opacity-85 transition hover:text-[#e9c77a] hover:opacity-100" href={href}>{label}</a>)}
        </nav>
        <a href="#visit" class="rounded-full border border-white/45 px-4 py-2 text-xs font-bold transition hover:border-[#e9c77a] hover:bg-[#e9c77a] hover:text-[#162b27]">اپنے سفر کی تیاری</a>
      </div>
    </header>
    <main id="top">
      <slot />
    </main>
    <footer class="border-t border-white/10 bg-[#0d201d] text-[#e7f0ea]">
      <div class="container-shell grid gap-10 py-14 md:grid-cols-[1fr_auto] md:items-start">
        <div>
          <img src="/logo.svg" width="180" height="46" alt="مزارِ قائد" class="mb-5 h-auto w-[180px]" />
          <p class="max-w-xl text-sm leading-8 text-[#c5d5cc]">مزارِ قائد کراچی کی ایک باوقار سیر، تاریخ اور خاموشی کو سمجھنے کے لیے ایک غیر سرکاری وزٹر گائیڈ ہے۔</p>
          <p class="mt-6 max-w-xl text-xs leading-7 text-[#8ca99b]">یہ ویب سائٹ غیر سرکاری ہے۔ اوقات، سکیورٹی ہدایات، داخلہ اور سہولیات میں تبدیلی ممکن ہے؛ روانگی سے پہلے مقام کی تازہ معلومات ضرور دیکھیں۔</p>
        </div>
        <div class="text-sm text-[#c5d5cc] md:text-left">
          <p class="mb-3 font-bold text-[#e9c77a]">فوری روابط</p>
          <div class="flex flex-col gap-2">
            <a class="transition hover:text-white" href="#intro">مزار کا تعارف</a>
            <a class="transition hover:text-white" href="#visit">آمد و رفت</a>
            <a class="transition hover:text-white" href="#map">نقشہ دیکھیں</a>
            <a class="transition hover:text-white" href="#faq">سوالات</a>
            <a class="transition hover:text-white" href="#sources">ماخذ</a>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 py-5 text-center text-[11px] text-[#8ca99b]">© مزارِ قائد گائیڈ · تصاویر کے ماخذ اور لائسنس نیچے درج ہیں</div>
    </footer>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
        });
      }
    </script>
  </body>
</html>